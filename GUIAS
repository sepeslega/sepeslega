        <footer class="mt-2 pt-2 border-t border-slate-200 grid grid-cols-12 gap-3 items-center">
            
            <!-- OBJETIVO (5 COLUNAS) -->
            <div class="col-span-5 flex items-center gap-2 bg-blue-50/60 p-2 rounded-lg border border-blue-200">
