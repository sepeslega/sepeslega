<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Diretrizes de Projetos - Licenciamento</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #e2e8f0;
            color: #1e293b;
            margin: 0;
            padding: 0;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        /* Container A4 Paisagem (297mm x 210mm) */
        .page-a4-landscape {
            width: 297mm;
            height: 210mm;
            background-color: #ffffff;
            margin: 15px auto;
            padding: 7mm 8mm;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
            position: relative;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow: hidden;
        }

        /* Impressão sem margens adicionais */
        @media print {
            @page {
                size: A4 landscape;
                margin: 0;
            }
            body {
                background: white;
            }
            .no-print {
                display: none !important;
            }
            .page-a4-landscape {
                margin: 0;
                box-shadow: none;
                width: 297mm;
                height: 210mm;
                padding: 6mm 8mm;
                page-break-after: always;
            }
        }

        /* Estilos e Cores Principais fiéis ao Infográfico */
        .color-priorizar-bg { background-color: #1e7e45; }
        .color-priorizar-card { background-color: #edf7ed; }
        .color-priorizar-text { color: #145a2d; }
        .color-priorizar-border { border-color: #a3d9a5; }

        .color-evitar-bg { background-color: #e59b12; }
        .color-evitar-card { background-color: #fef8e8; }
        .color-evitar-text { color: #925200; }
        .color-evitar-border { border-color: #f7d282; }

        .color-nao-intervir-bg { background-color: #be1e2d; }
        .color-nao-intervir-card { background-color: #fde8e8; }
        .color-nao-intervir-text { color: #8a1c1c; }
        .color-nao-intervir-border { border-color: #f9b1b1; }

        .color-checklist-bg { background-color: #0d47a1; }
        .color-checklist-card { background-color: #eef5fc; }
        .color-checklist-border { border-color: #b3d4fc; }

        .custom-checkbox {
            appearance: none;
            -webkit-appearance: none;
            width: 14px;
            height: 14px;
            border: 2px solid #0d47a1;
            border-radius: 2px;
            outline: none;
            cursor: pointer;
            position: relative;
            background-color: white;
            flex-shrink: 0;
        }
        .custom-checkbox:checked {
            background-color: #0d47a1;
        }
        .custom-checkbox:checked::after {
            content: '';
            position: absolute;
            left: 3px;
            top: 0px;
            width: 4px;
            height: 8px;
            border: solid white;
            border-width: 0 2px 2px 0;
            transform: rotate(45deg);
        }

        .bullet-list {
            list-style: none;
            padding-left: 0;
        }
        .bullet-list li {
            position: relative;
            padding-left: 10px;
            margin-bottom: 2px;
            font-size: 8px;
            line-height: 1.25;
        }
        .bullet-list li::before {
            content: "•";
            position: absolute;
            left: 0;
            color: currentColor;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <!-- BARRA DE CONTROLE PARA IMPRESSÃO (Apenas tela) -->
    <div class="no-print bg-slate-900 text-white p-2.5 shadow-md mb-2 flex justify-between items-center px-8">
        <div class="flex items-center space-x-3">
            <span class="inline-block w-3 h-3 bg-green-500 rounded-full animate-pulse"></span>
            <span class="font-semibold text-sm">Infográfico Diretrizes de Projeto - Visualização A4 Paisagem (297mm x 210mm)</span>
        </div>
        <div class="flex gap-3">
            <button onclick="window.print()" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold py-2 px-4 rounded-lg transition-all flex items-center gap-2 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                </svg>
                Imprimir / Salvar PDF
            </button>
        </div>
    </div>

    <div class="page-a4-landscape">

        <!-- CABEÇALHO -->
        <header class="flex justify-between items-center border-b border-slate-200 pb-1.5 mb-2">
            <!-- LOGO ESQUERDA SEPE -->
            <div class="flex items-center gap-2 w-[22%]">
                <div class="text-right border-r-2 border-slate-800 pr-2">
                          </div>
                <div>
                    <h1 class="text-2xl font-black tracking-tight text-slate-900 leading-none">SEPE</h1>
                </div>
            </div>

            <!-- TÍTULO CENTRAL -->
            <div class="text-center w-[56%] px-2">
                <div class="flex items-center justify-center gap-2">
                    <span class="h-6 w-1 bg-blue-700 inline-block"></span>
                    <h1 class="text-xl font-black text-blue-900 tracking-wide uppercase leading-tight">DIRETRIZES DE PROJETOS</h1>
                    <span class="h-6 w-1 bg-blue-700 inline-block"></span>
                </div>
                <p class="text-[8.5px] text-slate-600 font-medium leading-tight mt-0.5">
                    Orientações para desenvolvimento de projetos e obras nas unidades de saúde, visando maior eficiência na elaboração de projetos, redução de impactos e licenciamentos menos complexos
                </p>
            </div>

            <!-- LOGO DIREITA GOVERNO / BRASÃO -->
            <div class="flex items-center justify-end gap-2 w-[22%]">
                <div class="text-right">
                    <p class="text-[8px] font-semibold text-slate-700 leading-tight">Secretaria<br>de Projetos<br>Estratégicos</p>
                </div>
                
            </div>
            
        </header>

        <!-- CORPO PRINCIPAL - 4 COLUNAS FIÉIS AO INFOGRÁFICO -->
        <main class="grid grid-cols-4 gap-2 flex-grow">

            <!-- ================= COLUNA 1: PRIORIZAR ================= -->
            <section class="flex flex-col h-full">
                <!-- Cabeçalho da Coluna -->
                <div class="color-priorizar-bg text-white text-center py-1 px-2 rounded-t font-extrabold text-[11px] tracking-wider uppercase mb-1 shadow-xs">
                    PRIORIZAR
                </div>

                <!-- Conteúdo dos Cards -->
                <div class="space-y-1 flex-grow flex flex-col justify-between">

                    <!-- Card 1 -->
                    <div class="color-priorizar-card p-1.5 rounded border color-priorizar-border flex gap-1.5 items-start">
                        <svg class="w-5 h-5 color-priorizar-text flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V5l12-2v12M9 17l12-2M9 17H5a2 2 0 01-2-2V5a2 2 0 012-2h4M9 5a2 2 0 012-2h10a2 2 0 012 2v10a2 2 0 01-2 2H11a2 2 0 01-2-2"></path>
                        </svg>
                        <div>
                            <h2 class="font-black text-[9px] color-priorizar-text uppercase leading-tight mb-0.5">READEQUAÇÕES INTERNAS</h2>
                            <ul class="bullet-list text-slate-700">
                                <li>Reorganização de layouts</li>
                                <li>Redistribuição de ambientes</li>
                                <li>Otimização de fluxos</li>
                                <li>Aproveitamento da estrutura existente</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Card 2 -->
                    <div class="color-priorizar-card p-1.5 rounded border color-priorizar-border flex gap-1.5 items-start">
                        <svg class="w-5 h-5 color-priorizar-text flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a2 2 0 01-2 2 2 2 0 01-2-2V4zm-6 8a2 2 0 100-4 2 2 0 000 4zm0 0v8m0-8h14m0 0a2 2 0 100-4 2 2 0 000 4zm0 0v8m-7-4h.01"></path>
                        </svg>
                        <div>
                            <h2 class="font-black text-[9px] color-priorizar-text uppercase leading-tight mb-0.5">REFORMAS EM EDIFICAÇÕES EXISTENTES</h2>
                            <ul class="bullet-list text-slate-700">
                                <li>Modernização de instalações</li>
                                <li>Adequações normativas</li>
                                <li>Atualizações funcionais</li>
                                <li>Retrofit</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Card 3 -->
                    <div class="color-priorizar-card p-1.5 rounded border color-priorizar-border flex gap-1.5 items-start">
                        <svg class="w-5 h-5 color-priorizar-text flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h4m-4 0V11m0 0V7m0 4h4m-4 0H7"></path>
                        </svg>
                        <div>
                            <h2 class="font-black text-[9px] color-priorizar-text uppercase leading-tight mb-0.5">AMPLIAÇÕES</h2>
                            <ul class="bullet-list text-slate-700">
                                <li>Verticais, sempre que tecnicamente viáveis, respeitando gabaritos e coeficientes urbanos</li>
                                <li>Horizontais apenas quando estritamente necessários</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Card 4 -->
                    <div class="color-priorizar-card p-1.5 rounded border color-priorizar-border flex gap-1.5 items-start">
                        <svg class="w-5 h-5 color-priorizar-text flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                        </svg>
                        <div>
                            <h2 class="font-black text-[9px] color-priorizar-text uppercase leading-tight mb-0.5">REFORMAS DE FACHADAS</h2>
                            <ul class="bullet-list text-slate-700">
                                <li>Recuperação de revestimentos</li>
                                <li>Modernização arquitetônica</li>
                                <li>Adequações de acessibilidade</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Card 5 -->
                    <div class="color-priorizar-card p-1.5 rounded border color-priorizar-border flex gap-1.5 items-start">
                        <svg class="w-5 h-5 color-priorizar-text flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4 2 2 0 000 4zm0 0v2m0-6V4m6 6v10m6-2a2 2 0 100-4 2 2 0 000 4zm0 0v2m0-6V4"></path>
                        </svg>
                        <div>
                            <h2 class="font-black text-[9px] color-priorizar-text uppercase leading-tight mb-0.5">APROVEITAMENTO DA INFRAESTRUTURA EXISTENTE</h2>
                            <ul class="bullet-list text-slate-700">
                                <li>Redes de drenagem</li>
                                <li>Redes de esgoto</li>
                                <li>Sistemas Elétricos</li>
                                <li>Reservatórios existentes</li>
                                <li>Redes de gases</li>
                            </ul>
                        </div>
                    </div>

                </div>
            </section>

            <!-- ================= COLUNA 2: EVITAR ================= -->
            <section class="flex flex-col h-full">
                <!-- Cabeçalho da Coluna -->
                <div class="color-evitar-bg text-white text-center py-1 px-2 rounded-t font-extrabold text-[11px] tracking-wider uppercase mb-1 shadow-xs">
                    EVITAR
                </div>

                <!-- Conteúdo dos Cards -->
                <div class="space-y-1 flex-grow flex flex-col justify-between">

                    <!-- Card 1 -->
                    <div class="color-evitar-card p-1.5 rounded border color-evitar-border flex gap-1.5 items-start">
                        <svg class="w-5 h-5 color-evitar-text flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"></path>
                        </svg>
                        <div>
                            <h2 class="font-black text-[9px] color-evitar-text uppercase leading-tight mb-0.5">MOVIMENTAÇÕES SIGNIFICATIVAS DE TERRA</h2>
                            <ul class="bullet-list text-slate-700">
                                <li>Cortes</li>
                                <li>Aterros</li>
                                <li>Contenções externas</li>
                                <li>Alterações topográficas relevantes</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Card 2 -->
                    <div class="color-evitar-card p-1.5 rounded border color-evitar-border flex gap-1.5 items-start">
                        <svg class="w-5 h-5 color-evitar-text flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                        </svg>
                        <div>
                            <h2 class="font-black text-[9px] color-evitar-text uppercase leading-tight mb-0.5">AMPLIAÇÕES HORIZONTAIS DESNECESSÁRIAS</h2>
                            <ul class="bullet-list text-slate-700">
                                <li>Ocupação de áreas livres</li>
                                <li>Aumento da impermeabilização do solo</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Card 3 -->
                    <div class="color-evitar-card p-1.5 rounded border color-evitar-border flex gap-1.5 items-start">
                        <svg class="w-5 h-5 color-evitar-text flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                        <div>
                            <h2 class="font-black text-[9px] color-evitar-text uppercase leading-tight mb-0.5">INTERVENÇÕES PRÓXIMAS A CORPOS HÍDRICOS</h2>
                            <ul class="bullet-list text-slate-700">
                                <li>Rios</li>
                                <li>Canais</li>
                                <li>Lagoas</li>
                                <li>Áreas alagáveis</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Card 4 -->
                    <div class="color-evitar-card p-1.5 rounded border color-evitar-border flex gap-1.5 items-start">
                        <svg class="w-5 h-5 color-evitar-text flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                        </svg>
                        <div>
                            <h2 class="font-black text-[9px] color-evitar-text uppercase leading-tight mb-0.5">ALTERAÇÕES EM SISTEMAS NATURAIS DE DRENAGEM</h2>
                            <ul class="bullet-list text-slate-700">
                                <li>Canalizações</li>
                                <li>Aterros de depressões naturais</li>
                                <li>Modificações de escoamento superficial</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Card 5 -->
                    <div class="color-evitar-card p-1.5 rounded border color-evitar-border flex gap-1.5 items-start">
                        <svg class="w-5 h-5 color-evitar-text flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                        </svg>
                        <div>
                            <h2 class="font-black text-[9px] color-evitar-text uppercase leading-tight mb-0.5">VEGETAÇÕES</h2>
                            <ul class="bullet-list text-slate-700">
                                <li>Supressão de espécies arbóreas</li>
                                <li>Intervenções em APPs</li>
                            </ul>
                        </div>
                    </div>

                </div>
            </section>

            <!-- ================= COLUNA 3: NÃO INTERVIR SEM ANÁLISE PRÉVIA ================= -->
            <section class="flex flex-col h-full">
                <!-- Cabeçalho da Coluna -->
                <div class="color-nao-intervir-bg text-white text-center py-1 px-1 rounded-t font-extrabold text-[10px] tracking-tight uppercase mb-1 shadow-xs leading-tight">
                    NÃO INTERVIR SEM ANÁLISE PRÉVIA DE VIABILIDADES
                </div>

                <!-- Conteúdo dos Cards -->
                <div class="space-y-1 flex-grow flex flex-col justify-between">

                    <!-- Card 1 -->
                    <div class="color-nao-intervir-card p-1.5 rounded border color-nao-intervir-border flex gap-1.5 items-start">
                        <svg class="w-5 h-5 color-nao-intervir-text flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                        </svg>
                        <div>
                            <h2 class="font-black text-[9px] color-nao-intervir-text uppercase leading-tight mb-0.5">VEGETAÇÕES</h2>
                            <ul class="bullet-list text-slate-700">
                                <li>Priorizar preservação de espécies arbóreas</li>
                                <li>Compatibilização com Inventário Florestal</li>
                                <li>Compensações municipais de solo natural</li>
                                <li>Recuos em torno de áreas úmidas e alagadas</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Card 2 -->
                    <div class="color-nao-intervir-card p-1.5 rounded border color-nao-intervir-border flex gap-1.5 items-start">
                        <svg class="w-5 h-5 color-nao-intervir-text flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                        <div>
                            <h2 class="font-black text-[9px] color-nao-intervir-text uppercase leading-tight mb-0.5">INSTALAÇÕES</h2>
                            <ul class="bullet-list text-slate-700">
                                <li>Novas ETEs</li>
                                <li>Expansão de redes públicas de água e esgoto, priorizando o aproveitamento dos pontos de conexão existentes</li>
                                <li>Aumento das demandas de água, esgoto, drenagem, energia e gases (avaliar a capacidade das infraestruturas existentes)</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Card 3 -->
                    <div class="color-nao-intervir-card p-1.5 rounded border color-nao-intervir-border flex gap-1.5 items-start">
                        <svg class="w-5 h-5 color-nao-intervir-text flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
                        </svg>
                        <div>
                            <h2 class="font-black text-[9px] color-nao-intervir-text uppercase leading-tight mb-0.5">ESTRADAS E RODOVIAS</h2>
                            <ul class="bullet-list text-slate-700">
                                <li>Novos acessos diretos em estradas e rodovias (priorize o uso de vias locais)</li>
                                <li>Ocupar no limite dos recuos e faixas de domínio</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Card 4 -->
                    <div class="color-nao-intervir-card p-1.5 rounded border color-nao-intervir-border flex gap-1.5 items-start">
                        <svg class="w-5 h-5 color-nao-intervir-text flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"></path>
                        </svg>
                        <div>
                            <h2 class="font-black text-[9px] color-nao-intervir-text uppercase leading-tight mb-0.5">PROJETOS ARQUITETÔNICOS</h2>
                            <p class="text-[8px] text-slate-700 leading-tight">
                                Sempre que as intervenções forem passíveis de aprovação de projetos arquitetônicos nos municípios elas terão como requisito a emissão de Licenciamentos Ambientais. Reformas internas e readequações sem acréscimos de área construída são processos mais simplificados de licenciamento
                            </p>
                        </div>
                    </div>

                </div>
            </section>

            <!-- ================= COLUNA 4: CHECKLIST RÁPIDO ================= -->
            <section class="flex flex-col h-full">
                <!-- Cabeçalho da Coluna -->
                <div class="color-checklist-bg text-white text-center py-1 px-2 rounded-t font-extrabold text-[11px] tracking-wider uppercase mb-1 shadow-xs">
                    CHECKLIST RÁPIDO
                </div>

                <!-- Conteúdo do Checklist -->
                <div class="color-checklist-card p-1.5 rounded border color-checklist-border flex-grow flex flex-col justify-between space-y-1">
                    
                    <label class="flex items-start gap-2 bg-white p-1 rounded border border-blue-100 shadow-2xs cursor-pointer hover:bg-blue-50/50 transition-colors">
                        <input type="checkbox" class="custom-checkbox mt-0.5">
                        <span class="text-[8px] font-semibold text-slate-800 leading-tight">Há necessidade se supressão vegetal?</span>
                    </label>

                    <label class="flex items-start gap-2 bg-white p-1 rounded border border-blue-100 shadow-2xs cursor-pointer hover:bg-blue-50/50 transition-colors">
                        <input type="checkbox" class="custom-checkbox mt-0.5">
